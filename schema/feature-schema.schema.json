{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "dims": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "numeric"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": "number"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "ordinal"
              },
              "levels": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "levels"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "categorical"
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "binary"
              },
              "default": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "dims"
  ],
  "additionalProperties": false,
  "description": "The dimensions of an item feature vector: numeric (min/max), ordinal (levels), categorical (values) or binary.",
  "title": "sigilsmith feature schema"
}
