{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "description": "Free text; JSON has no comments.",
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "itemType": {
      "default": {
        "field": "type"
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "field"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "default": [],
              "description": "Fields used (as a composite) when the key is missing; a warning is emitted.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "onMissing": {
              "default": "fallback",
              "type": "string",
              "enum": [
                "fallback",
                "throw"
              ]
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fallback": {
              "default": [],
              "description": "Fields used (as a composite) when the key is missing; a warning is emitted.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "onMissing": {
              "default": "fallback",
              "type": "string",
              "enum": [
                "fallback",
                "throw"
              ]
            }
          },
          "required": [
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "custom": {
              "type": "string",
              "pattern": "#"
            },
            "fallback": {
              "default": [],
              "description": "Fields used (as a composite) when the key is missing; a warning is emitted.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "onMissing": {
              "default": "fallback",
              "type": "string",
              "enum": [
                "fallback",
                "throw"
              ]
            }
          },
          "required": [
            "custom"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How to get an item's stable key. Write it with `sigilsmith detect-key --write`."
    },
    "label": {
      "default": {
        "fields": [
          "name",
          "title",
          "label",
          "displayName",
          "username"
        ]
      },
      "type": "object",
      "properties": {
        "fields": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fields"
      ]
    },
    "presets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generators": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
        "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "A field path (`title`, `meta.uuid`), `$key` or `$label`."
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxChars": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "as": {
                      "description": "Name the generator sees (e.g. keep `title` when the data field becomes `name`).",
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Generator params; validated against the generator manifest by `check`."
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "default": [],
      "description": "Generator modules outside sigilsmith: a project file (`./src/sigils/orb.js`) or a package, each default-exporting a generator module. Seen by catalog, build, explain, preview and check like the built-ins.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remote": {
      "default": {},
      "description": "Remote/async generators and their transports. Keys never go here.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
        "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "proxy"
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "transport",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "dicebear"
              },
              "style": {
                "default": "shapes",
                "type": "string"
              },
              "baseUrl": {
                "description": "A self-hosted DiceBear API: required for commercial use.",
                "type": "string",
                "format": "uri"
              },
              "use": {
                "description": "Acknowledge that the public api.dicebear.com is used for a non-commercial app (its terms).",
                "type": "string",
                "enum": [
                  "non-commercial"
                ]
              }
            },
            "required": [
              "transport"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "mock"
              },
              "latencyMs": {
                "default": 300,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "transport"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "module"
              },
              "module": {
                "type": "string",
                "pattern": "#"
              }
            },
            "required": [
              "transport",
              "module"
            ],
            "additionalProperties": false,
            "description": "A custom transport exported by your code, e.g. BYOK."
          }
        ]
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
          "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
        },
        "salt": {
          "default": "sigilsmith",
          "type": "string"
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "includes": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "includes"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "exists": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "exists"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "Item field → value, list of values, `{ includes }` or `{ exists }`. All must match."
              },
              "use": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
                    "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
                      "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
                    },
                    "additionalProperties": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                ],
                "description": "A ref, or a weight map for deterministic weighted selection."
              },
              "inputs": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "description": "A field path (`title`, `meta.uuid`), `$key` or `$label`."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxChars": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "as": {
                          "description": "Name the generator sees (e.g. keep `title` when the data field becomes `name`).",
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "field"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
                  "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Generator params; validated against the generator manifest by `check`."
                }
              }
            },
            "required": [
              "when",
              "use"
            ],
            "additionalProperties": false
          }
        },
        "placeholder": {
          "default": "grid@1",
          "description": "Pure generator shown while a remote generator works.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$"
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "default": {
        "strategy": "materialized",
        "format": "svg"
      },
      "type": "object",
      "properties": {
        "strategy": {
          "default": "materialized",
          "type": "string",
          "enum": [
            "materialized",
            "derived",
            "hybrid"
          ]
        },
        "format": {
          "default": "svg",
          "type": "string",
          "enum": [
            "svg",
            "png"
          ]
        }
      },
      "additionalProperties": false
    },
    "regeneration": {
      "default": {
        "policy": "auto"
      },
      "type": "object",
      "properties": {
        "policy": {
          "default": "auto",
          "description": "auto: each generator's own default (initials: always), else ask.",
          "type": "string",
          "enum": [
            "auto",
            "ask",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "default": {},
      "type": "object",
      "properties": {
        "maxGzipBytes": {
          "description": "Total gzip bytes sigilsmith may add to the app: kernel + the delivery, React and remote modules in use + every generator the config can select. Not per generator (that is `catalog --max-gzip`).",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "userSettings": {
      "default": {
        "choices": [],
        "perType": true,
        "params": {}
      },
      "type": "object",
      "properties": {
        "choices": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
            "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
          }
        },
        "perType": {
          "default": true,
          "type": "boolean"
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
            "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "default": [],
      "description": "Feature-driven sigils: per item set, a feature schema, a mapping to generator params, and optionally a vector table.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "description": "Which items this set covers (as a policy rule); omitted: every item.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "includes": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "includes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "exists": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "exists"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "field": {
            "default": "features",
            "description": "Item field holding the vector; checked before `vectors`.",
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Path (relative to the config) of a JSON file holding the feature schema."
              },
              {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string"
                  },
                  "$comment": {
                    "type": "string"
                  },
                  "dims": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "numeric"
                            },
                            "min": {
                              "type": "number"
                            },
                            "max": {
                              "type": "number"
                            },
                            "default": {
                              "type": "number"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "ordinal"
                            },
                            "levels": {
                              "minItems": 2,
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "default": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "levels"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "categorical"
                            },
                            "values": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "default": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "values"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "binary"
                            },
                            "default": {
                              "type": "boolean"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "dims"
                ],
                "additionalProperties": false,
                "description": "The dimensions of a feature vector: numeric (min/max), ordinal (levels), categorical (values) or binary."
              }
            ]
          },
          "mapping": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Path (relative to the config) of a JSON file holding the mapping."
              },
              {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string"
                  },
                  "$comment": {
                    "type": "string"
                  },
                  "use": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
                    "description": "The generator that draws these items."
                  },
                  "encodings": {
                    "type": "object",
                    "propertyNames": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*(\\/[a-z0-9-]+)?@\\d+$",
                          "description": "Generator reference: `<id>@<major>`. The major pins the output contract."
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        }
                      ]
                    },
                    "additionalProperties": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "value": {}
                                },
                                "required": [
                                  "value"
                                ],
                                "additionalProperties": false,
                                "description": "A constant."
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "from": {
                                    "type": "string"
                                  },
                                  "range": {
                                    "type": "array",
                                    "prefixItems": [
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ],
                                    "items": false,
                                    "minItems": 2,
                                    "maxItems": 2
                                  },
                                  "round": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "from",
                                  "range"
                                ],
                                "additionalProperties": false,
                                "description": "Interpolate a numeric, ordinal or binary dimension linearly into [a, b]."
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "from": {
                                    "type": "string"
                                  },
                                  "map": {
                                    "type": "object",
                                    "propertyNames": {
                                      "type": "string"
                                    },
                                    "additionalProperties": {}
                                  },
                                  "default": {}
                                },
                                "required": [
                                  "from",
                                  "map"
                                ],
                                "additionalProperties": false,
                                "description": "Look a value (ordinal level, category, \"true\"/\"false\", or an integer as text) up."
                              }
                            ]
                          },
                          {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "value": {}
                                  },
                                  "required": [
                                    "value"
                                  ],
                                  "additionalProperties": false,
                                  "description": "A constant."
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "from": {
                                      "type": "string"
                                    },
                                    "range": {
                                      "type": "array",
                                      "prefixItems": [
                                        {
                                          "type": "number"
                                        },
                                        {
                                          "type": "number"
                                        }
                                      ],
                                      "items": false,
                                      "minItems": 2,
                                      "maxItems": 2
                                    },
                                    "round": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "from",
                                    "range"
                                  ],
                                  "additionalProperties": false,
                                  "description": "Interpolate a numeric, ordinal or binary dimension linearly into [a, b]."
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "from": {
                                      "type": "string"
                                    },
                                    "map": {
                                      "type": "object",
                                      "propertyNames": {
                                        "type": "string"
                                      },
                                      "additionalProperties": {}
                                    },
                                    "default": {}
                                  },
                                  "required": [
                                    "from",
                                    "map"
                                  ],
                                  "additionalProperties": false,
                                  "description": "Look a value (ordinal level, category, \"true\"/\"false\", or an integer as text) up."
                                }
                              ]
                            },
                            "description": "Tried in order; the first that yields a value wins (a map without a default yields nothing for an unlisted level)."
                          }
                        ]
                      }
                    },
                    "description": "Generator ref (`glyph@1`) or id for any major (`glyph`) → param path (dotted) → encoding."
                  }
                },
                "required": [
                  "use",
                  "encodings"
                ],
                "additionalProperties": false
              }
            ]
          },
          "vectors": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Path (relative to the config) of a JSON file holding the vectors (item key → vector; `$`-prefixed keys are ignored)."
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          }
        },
        "required": [
          "schema",
          "mapping"
        ],
        "additionalProperties": false
      }
    },
    "samples": {
