{
  "name": "sigilsmith",
  "version": "0.3.1",
  "description": "Agent-first builder for deterministic identity images (identicons, avatars, thumbnails, favicons): a catalog of generators behind one facade, an SSOT config, and a CLI that chooses, previews, explains and checks.",
  "author": "Thor Whalen",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorwhalen/sigilsmith.git"
  },
  "homepage": "https://github.com/thorwhalen/sigilsmith#readme",
  "bugs": {
    "url": "https://github.com/thorwhalen/sigilsmith/issues"
  },
  "keywords": [
    "identicon",
    "avatar",
    "thumbnail",
    "favicon",
    "og-image",
    "deterministic",
    "svg",
    "agent",
    "mcp",
    "zodal"
  ],
  "bin": {
    "sigilsmith": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "catalog",
    "schema",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generators/*": {
      "types": "./dist/generators/*.d.ts",
      "import": "./dist/generators/*.js"
    },
    "./extras/*": {
      "types": "./dist/extras/*.d.ts",
      "import": "./dist/extras/*.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./delivery": {
      "types": "./dist/delivery.d.ts",
      "import": "./dist/delivery.js"
    },
    "./targets": {
      "types": "./dist/targets/index.d.ts",
      "import": "./dist/targets/index.js"
    },
    "./zodal": {
      "types": "./dist/zodal/index.d.ts",
      "import": "./dist/zodal/index.js"
    },
    "./zodal/settings": {
      "types": "./dist/zodal/settings.d.ts",
      "import": "./dist/zodal/settings.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json",
    "./schema/config.schema.json": "./schema/config.schema.json",
    "./schema/feature-schema.schema.json": "./schema/feature-schema.schema.json",
    "./schema/feature-mapping.schema.json": "./schema/feature-mapping.schema.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure-sizes.mjs",
    "golden": "vitest run tests/golden.test.ts --update",
    "schema": "node scripts/write-schema.mjs",
    "docs": "node scripts/write-docs.mjs",
    "prepare_assets": "npm run build && npm run measure && npm run schema && npm run docs",
    "prepack": "npm run build && npm run measure && npm run schema && npm run docs"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@zodal/dials-core": "^0.1.0 || ^0.2.0",
    "@zodal/dials-ui": "^0.1.0 || ^0.2.0",
    "@zodal/store": "^0.1.2 || ^0.2.0",
    "minidenticons": "^4.2.1",
    "react": "^18 || ^19",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "esbuild": ">=0.20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "minidenticons": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    },
    "@zodal/store": {
      "optional": true
    },
    "@zodal/dials-core": {
      "optional": true
    },
    "@zodal/dials-ui": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zodal/core": "^0.2.0",
    "@zodal/dials-codegen": "^0.1.0",
    "@zodal/dials-core": "^0.1.0",
    "@zodal/dials-store-secret": "^0.1.0",
    "@zodal/dials-ui": "^0.1.0",
    "@zodal/dials-ui-shadcn": "^0.1.0",
    "@zodal/store": "^0.2.0",
    "@zodal/store-http": "^0.1.0",
    "@zodal/ui": "^0.2.0",
    "esbuild": "^0.28.2",
    "minidenticons": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@zodal/core": "$@zodal/core",
    "@zodal/store": "$@zodal/store",
    "@zodal/ui": "$@zodal/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
