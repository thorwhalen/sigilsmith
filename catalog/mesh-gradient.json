    "lastRelease": "2026-05-05",
    "maintenance": "maintained"
  },
  "license": {
    "spdx": "MIT",
    "mitCompatible": true,
    "restrictions": [],
    "notes": "Name 'MeshGradient.js' maps to several packages (mesh-gradient.js, stripe-gradient 2022, @mesh-gradient/core, @paper-design/shaders); no single canonical one."
  },
  "bundleSize": {
    "minGzipBytes": null,
    "brotliBytes": null,
    "measured": false,
    "source": "Repository README states ~8 kB gzipped (unverified)"
  },
  "lazyLoadable": true,
  "runtime": {
    "browser": true,
    "node": false,
    "edge": false,
    "webgpu": false,
